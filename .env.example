# Note the doubled /api: the deployed backend on the VM runs with an extra
# server.servlet.context-path=/api on top of its controllers' own /api/...
# mappings, confirmed by a working POST to https://grh.entraide.ma/api/api/auth/login
# returning 200 while the single /api path 401s. This isn't visible in the
# siipe-backend repo (likely set via an untracked prod properties file or
# startup flag on the VM) — keep this doubled until that's changed server-side.
NEXT_PUBLIC_API_URL=https://grh.entraide.ma/api/api
NEXT_PUBLIC_TILES_URL=/tiles/morocco.pmtiles
